---
import type { Videojuego } from '../lib/types';

interface Props {
  juego: Videojuego;
}

const { juego } = Astro.props;
const tieneDescuento = juego.descuento > 0;
const precioRebajado = juego.precio * (1 - juego.descuento / 100);
const imagenFinal = juego.imagenUrl || '/placeholder.jpg';
---

<div class="bg-gray-800 rounded-lg overflow-hidden shadow-lg transition-transform hover:scale-105 flex flex-col h-full">
  <div class="relative w-full h-56 bg-slate-950 flex items-center justify-center">
    <img 
      src={imagenFinal} 
      alt={juego.titulo} 
      onerror="this.src='/placeholder.jpg'; this.onerror=null;"
      class="max-w-full max-h-full object-contain drop-shadow-md" 
    />
    {tieneDescuento && (
      <span class="absolute top-2 right-2 bg-red-600 text-white text-xs font-bold px-2 py-1 rounded shadow">
        -{juego.descuento}%
      </span>
    )}
  </div>
  
  <div class="p-4 flex flex-col flex-grow">
    <h3 class="text-xl font-bold text-white truncate">{juego.titulo}</h3>
    <p class="text-gray-400 text-sm h-10 overflow-hidden line-clamp-2 mt-1">{juego.descripcion}</p>
    
    <div class="mt-auto pt-4 flex items-center justify-between">
      <div class="flex flex-col">
        {tieneDescuento ? (
          <>
            <span class="text-gray-500 line-through text-xs">${juego.precio.toFixed(2)}</span>
            <span class="text-green-400 font-bold text-xl">${precioRebajado.toFixed(2)}</span>
          </>
        ) : (
          <span class="text-white font-bold text-xl">${juego.precio.toFixed(2)}</span>
        )}
      </div>
      <button 
        class="bg-blue-600 hover:bg-blue-700 text-white px-3 py-2 rounded-md text-sm transition-colors add-to-cart"
        data-id={juego.id}
        disabled={juego.stock <= 0}
      >
        {juego.stock > 0 ? 'Agregar' : 'Agotado'}
      </button>
    </div>
  </div>
</div>